{
  "name": "bluey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bluey \u2014 a real-time AI desktop context copilot for macOS (Tauri v2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p sidecars/agent/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"sidecars/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun run build:helpers && tauri build",
    "build:helper": "bash scripts/build-helper.sh",
    "build:agent": "bash scripts/build-agent.sh",
    "build:helpers": "bash scripts/build-helper.sh && bash scripts/build-agent.sh",
    "check:rust": "bash scripts/check-rust.sh",
    "test:rust": "cd src-tauri && cargo test -p bluey-core -p bluey-storage",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@clerk/clerk-js": "^6",
    "@clerk/react": "^6",
    "@clerk/ui": "^1",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-scroll-area": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-slider": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "latest",
    "mermaid": "^11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10",
    "remark-gfm": "^4",
    "shiki": "^3",
    "tailwind-merge": "^3",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bun": "latest",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "jsdom": "^26",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.0.16",
    "vitest": "^3"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
