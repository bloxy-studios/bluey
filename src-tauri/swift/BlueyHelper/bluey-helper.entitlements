<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime resource access: without this the runtime blocks
         AVAudioEngine microphone input outright (before TCC is even asked).
         https://developer.apple.com/documentation/bundleresources/entitlements/com.apple.security.device.audio-input -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
