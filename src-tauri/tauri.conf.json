{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluey",
  "version": "0.1.0-rc.1",
  "identifier": "com.codewithabdul.bluey",
  "build": {
    "beforeDevCommand": "bash scripts/ensure-sidecars.sh && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bluey",
        "url": "index.html?window=main",
        "width": 754,
        "height": 175,
        "minWidth": 484,
        "minHeight": 175,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Bluey Settings",
        "url": "index.html?window=settings",
        "width": 930,
        "height": 690,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "onboarding",
        "title": "Welcome to Bluey",
        "url": "index.html?window=onboarding",
        "width": 760,
        "height": 560,
        "resizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://img.clerk.com https://*.clerk.com https://*.clerk.accounts.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Bluey — real-time AI desktop copilot",
    "longDescription": "Bluey understands what is happening on your screen and in your conversations, with your explicit permission, and prepares concise contextual help.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bluey-helper",
      "binaries/bluey-agent"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "bluey"
        ]
      }
    }
  }
}
