# ── Bluey environment (copy to .env — never commit real values) ─────────────
#
# Only VITE_* variables reach the WebView. Everything else is read by the Rust
# backend at startup; secrets are moved into the macOS Keychain the first time they
# are seen (only when the Keychain has no entry yet — set
# BLUEY_ENV_OVERRIDES_KEYCHAIN=1 to replace existing entries) and can be deleted from
# this file afterwards. Keys can also be entered in Settings → AI (Keychain only,
# never SQLite or logs). The import logs "imported api key for provider <id>" and
# nothing else.

# ── Default provider ─────────────────────────────────────────────────────────
# One Google AI Studio key drives every feature: chat + screenshot vision
# (gemini-3.8-flash / gemini-3.5-flash-lite), live + batch transcription
# (gemini-3.5-transcribe-live / gemini-3.5-transcribe), embeddings (gemini-embedding-2)
# and deep research (gemini-3.8-flash function calling). Create one at
# https://aistudio.google.com/apikey — the free tier is enough to evaluate Bluey.
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
# Optional: self-hosted proxy in front of generativelanguage.googleapis.com/v1beta.
GEMINI_BASE_URL=

# Which provider the import nominates as the default: gemini (default when a Gemini key is
# present) | azure-foundry | anthropic | openai. Settings → AI → "Default provider" changes it
# later; per-role assignments allow mixed setups.
BLUEY_AI_PROVIDER=gemini

# Per-role model overrides for the default provider (all optional; the provider's presets
# apply otherwise — see docs/AI_ARCHITECTURE.md). Gemini presets:
#   default/vision/research gemini-3.8-flash · fast gemini-3.5-flash-lite · reasoning
#   gemini-3.8-flash (thinkingLevel high) · transcription gemini-3.5-transcribe ·
#   embedding gemini-embedding-2
BLUEY_MODEL_DEFAULT=
BLUEY_MODEL_FAST=
BLUEY_MODEL_REASONING=
BLUEY_MODEL_VISION=
BLUEY_MODEL_RESEARCH=
BLUEY_MODEL_TRANSCRIPTION=
BLUEY_MODEL_EMBEDDING=

# gemini-embedding-2 vectors are MRL-truncated to this size: 768 (default) | 1536 | 3072.
# Changing it re-indexes stored documents.
BLUEY_EMBEDDING_DIMENSIONS=768

# Live transcription: gemini_live (default — Gemini Live API, PCM16 16 kHz) | apple
# (on-device Speech) | cloud_realtime (MAI-Transcribe over Foundry Voice Live).
BLUEY_TRANSCRIPTION_PROVIDER=gemini_live

# Deep-research backend for the bluey-agent sidecar: gemini (default; needs only
# GEMINI_API_KEY) | claude (Claude Agent SDK; needs the Claude variables below and the
# "full" sidecar build: RESEARCH_BACKEND=claude bun run build:agent).
RESEARCH_BACKEND=gemini
# Research model. Default: gemini-3.8-flash (gemini backend) / claude-sonnet-5 (claude).
BLUEY_RESEARCH_MODEL=

# ── Alternates (optional) ────────────────────────────────────────────────────
# Microsoft Foundry / Azure OpenAI — OpenAI-compatible v1 GA endpoint
# ({AZURE_FOUNDRY_ENDPOINT}/openai/v1/…, no api-version). Leave AZURE_FOUNDRY_API_VERSION
# empty; set it to "preview" for v1 preview features or a dated value (e.g. 2024-10-21)
# only for the legacy /openai/deployments/{name}/…?api-version= endpoint. Presets:
# gpt-5.6-terra (default) · gpt-5.6-luna (fast) · gpt-6-astra (reasoning/vision/research) ·
# MAI-Transcribe-1.5 (transcription) · text-embedding-3-small (embedding).
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=
# Voice Live (BLUEY_TRANSCRIPTION_PROVIDER=cloud_realtime) needs a companion chat model on
# the WebSocket `model=` query: gpt-4.1-mini (Basic) or gpt-5-nano (Lite).
BLUEY_MODEL_VOICE_LIVE=gpt-4.1-mini

# Anthropic — direct (ANTHROPIC_API_KEY) or Claude in Microsoft Foundry (same resource key;
# base URL https://{resource}.services.ai.azure.com/anthropic). Presets: claude-sonnet-5
# (default/vision) · claude-haiku-4-5 (fast) · claude-opus-5 (reasoning/research).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Claude research backend on Foundry (RESEARCH_BACKEND=claude only). Claude Code / the Agent
# SDK read these variables; pin the alias → deployment mapping to what is deployed.
CLAUDE_CODE_USE_FOUNDRY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# Any OpenAI-compatible /v1/chat/completions endpoint (Bearer auth). Models are listed from
# the endpoint; there are no presets.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Research tools (optional — research degrades gracefully without them) ────
EXA_API_KEY=
FIRECRAWL_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Clerk — publishable key is public by design; the secret key is never used by Bluey.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: custom Frontend API domain (production instances), e.g. clerk.yourdomain.com
VITE_CLERK_FRONTEND_API_URL=

# ── Logging: error | warn | info | debug | trace (production default: info) ──
BLUEY_LOG_LEVEL=info
