# ── Bluey environment (copy to .env — never commit real values) ─────────────
#
# Only VITE_* variables reach the WebView. Everything else is read by the Rust
# backend at startup and, where it is a secret, moved into the macOS Keychain the
# first time it is seen. Keys can also be entered in Settings → AI (stored in the
# Keychain, never in SQLite or logs).

# Clerk — publishable key is public by design; the secret key is never used by Bluey.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: custom Frontend API domain (production instances), e.g. clerk.yourdomain.com
VITE_CLERK_FRONTEND_API_URL=

# Microsoft Foundry / Azure OpenAI (OpenAI-compatible v1 endpoint)
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-10-21
# Logical role → deployment/model names (all optional; configurable in Settings → Models)
BLUEY_MODEL_DEFAULT=gpt-4.1
BLUEY_MODEL_FAST=gpt-4.1-mini
BLUEY_MODEL_REASONING=o4-mini
BLUEY_MODEL_VISION=gpt-4.1
BLUEY_MODEL_EMBEDDING=text-embedding-3-small
BLUEY_MODEL_TRANSCRIPTION=gpt-4o-mini-transcribe

# Anthropic (Messages API for answers + Claude Agent SDK for deep research)
ANTHROPIC_API_KEY=
BLUEY_RESEARCH_MODEL=claude-sonnet-5

# Research tools (optional — research is disabled gracefully without them)
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Logging: error | warn | info | debug | trace  (production default: info)
BLUEY_LOG_LEVEL=info
