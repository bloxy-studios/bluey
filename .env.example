# ── Bluey environment (copy to .env — never commit real values) ─────────────
#
# Only VITE_* variables reach the WebView. Everything else is read by the Rust
# backend at startup and, where it is a secret, moved into the macOS Keychain the
# first time it is seen. Keys can also be entered in Settings → AI (stored in the
# Keychain, never in SQLite or logs).

# Clerk — publishable key is public by design; the secret key is never used by Bluey.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: custom Frontend API domain (production instances), e.g. clerk.yourdomain.com
VITE_CLERK_FRONTEND_API_URL=

# ── Microsoft Foundry (one resource serves OpenAI models, Claude and embeddings) ──
# OpenAI-compatible endpoint: {AZURE_FOUNDRY_ENDPOINT}/openai/v1/… — the v1 GA surface
# needs NO api-version. Leave AZURE_FOUNDRY_API_VERSION empty (recommended); set it to
# "preview" to opt into v1 preview features, or to a dated value (e.g. 2024-10-21) only if
# you must use the legacy /openai/deployments/{name}/…?api-version= endpoint.
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=
# Logical role → deployment names (all optional; configurable in Settings → Models).
# Deployment names default to the model id. Current line-up (Sep 2026):
#   gpt-6-astra (frontier, text+image, 1M ctx) · gpt-5.6-sol (deep reasoning) ·
#   gpt-5.6-terra (balanced, ~4x cheaper than Astra) · gpt-5.6-luna (fastest/cheapest)
BLUEY_MODEL_DEFAULT=gpt-5.6-terra
BLUEY_MODEL_FAST=gpt-5.6-luna
BLUEY_MODEL_REASONING=gpt-6-astra
BLUEY_MODEL_VISION=gpt-6-astra
BLUEY_MODEL_EMBEDDING=text-embedding-3-small
# Cloud transcription: MAI-Transcribe-1.5 over Voice Live (not /openai/v1/realtime).
# Wire id is MAI-Transcribe-1.5 (Foundry catalog name). Do NOT paste the azureml://
# registry URI — that is a catalog asset, not a Speech/Voice Live model string.
# MAI-Transcribe-2 is newer (diarization) but is not on every Foundry project.
BLUEY_MODEL_TRANSCRIPTION=MAI-Transcribe-1.5
# Voice Live requires a companion *chat* model on the WebSocket `model=` query even when
# the session is transcription-only (create_response=false). Fully managed — no Foundry
# deployment needed. gpt-4.1-mini = Basic; gpt-5-nano = Lite (cheaper). Do not use
# gpt-5.6-luna or gpt-6-astra here; they are not Voice Live companions.
BLUEY_MODEL_VOICE_LIVE=gpt-4.1-mini

# ── Claude: live answers (Messages API) + deep research (Claude Agent SDK) ──────────
# Option A — Claude through Microsoft Foundry (recommended when you already have the
# resource above; same key). Claude Code / the Agent SDK read these variables:
CLAUDE_CODE_USE_FOUNDRY=1
# Resource name → https://{resource}.services.ai.azure.com/anthropic. Optional when
# AZURE_FOUNDRY_ENDPOINT is set (the name is derived from its hostname).
ANTHROPIC_FOUNDRY_RESOURCE=your-resource
# Optional: defaults to AZURE_FOUNDRY_API_KEY. (Or ANTHROPIC_FOUNDRY_AUTH_TOKEN for Entra.)
ANTHROPIC_FOUNDRY_API_KEY=
# Pin the alias → deployment mapping to what is deployed in the resource. Without these,
# Claude Code falls back to older built-in defaults and Foundry has no startup model check.
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
# Live-answer provider (Settings → AI → Anthropic): base URL for Claude on Foundry.
ANTHROPIC_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
# Option B — Anthropic direct: unset CLAUDE_CODE_USE_FOUNDRY and set this instead.
ANTHROPIC_API_KEY=
# Deep-research model (a Foundry deployment name in option A). claude-opus-5 for depth,
# claude-sonnet-5 for cost.
BLUEY_RESEARCH_MODEL=claude-sonnet-5

# Research tools (optional — research is disabled gracefully without them)
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Logging: error | warn | info | debug | trace  (production default: info)
BLUEY_LOG_LEVEL=info
